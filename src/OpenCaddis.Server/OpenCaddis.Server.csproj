<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspNetCoreAssetsVersion>10.0.10</AspNetCoreAssetsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FabrCore.Host" Version="1.6.4-local.20260806162807" />
    <PackageReference Include="FabrCore.Surface" Version="1.6.4-local.20260806162807" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets"
                      Version="$(AspNetCoreAssetsVersion)"
                      GeneratePathProperty="true"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="fabrcore-surface.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="$(PkgMicrosoft_AspNetCore_App_Internal_Assets)\_framework\blazor.web.js"
                      LogicalName="OpenCaddis.Server.StaticAssets.blazor.web.js" />
    <EmbeddedResource Include="$(PkgFabrCore_Surface)\staticwebassets\surface.css"
                      LogicalName="OpenCaddis.Server.StaticAssets.surface.css" />
    <EmbeddedResource Include="$(PkgFabrCore_Surface)\staticwebassets\adaptiveCardsSurface.js"
                      LogicalName="OpenCaddis.Server.StaticAssets.adaptiveCardsSurface.js" />
  </ItemGroup>

</Project>
