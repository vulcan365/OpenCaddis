@inherits LayoutComponentBase
@inject FabrConfigService ConfigService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<TermsNoticeModal />

@if (_initialized)
{
    <div class="app-root @(_sidebarCollapsed ? "sidebar-collapsed" : "")">
        @* Header *@
        <header class="app-header">
            <button class="sidebar-toggle" @onclick="ToggleSidebar" title="Toggle sidebar">
                <i class="bi @(_sidebarCollapsed ? "bi-layout-sidebar-inset" : "bi-layout-sidebar")"></i>
            </button>
            <a href="/" class="brand-link">
                <img src="images/caddis-logo.png" alt="OpenCaddis Logo" class="brand-icon" style="height: 32px; width: auto;" />
                <span class="brand-text">OpenCaddis</span>
            </a>
            <div class="header-links">
                <a href="https://opencaddis.ai/" target="_blank" rel="noopener noreferrer" class="header-icon-link" title="OpenCaddis Website">
                    <i class="bi bi-globe2"></i>
                </a>
                <a href="https://github.com/vulcan365/OpenCaddis" target="_blank" rel="noopener noreferrer" class="header-icon-link" title="GitHub Repository">
                    <i class="bi bi-github"></i>
                </a>
            </div>
        </header>

        @* Below header: sidebar + content *@
        <div class="app-body">
            <nav class="app-sidebar">
                <div class="sidebar-nav-main">
                    <NavLink class="sidebar-link" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-house"></i>
                        <span class="sidebar-label">Dashboard</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="chat">
                        <i class="bi bi-chat-dots"></i>
                        <span class="sidebar-label">Chat</span>
                    </NavLink>
                </div>

                <div class="sidebar-nav-bottom">
                    <NavLink class="sidebar-link" href="setup">
                        <i class="bi bi-gear"></i>
                        <span class="sidebar-label">Settings</span>
                    </NavLink>
                </div>
            </nav>

            <main class="app-content">
                @Body
            </main>
        </div>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x2715;</span>
</div>

@code {
    private bool _initialized;
    private bool _sidebarCollapsed;

    protected override void OnInitialized()
    {
        var isSetupPage = Navigation.Uri.Contains("/setup", StringComparison.OrdinalIgnoreCase);

        if (!ConfigService.ConfigurationExists() && !isSetupPage)
        {
            Navigation.NavigateTo("/setup");
            return;
        }

        _initialized = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "oc-sidebar-collapsed");
            if (stored == "true")
            {
                _sidebarCollapsed = true;
                StateHasChanged();
            }
        }
    }

    private async Task ToggleSidebar()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
        await JS.InvokeVoidAsync("localStorage.setItem", "oc-sidebar-collapsed", _sidebarCollapsed ? "true" : "false");
    }
}
