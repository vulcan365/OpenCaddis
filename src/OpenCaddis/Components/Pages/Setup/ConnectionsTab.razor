@inject Microsoft365AuthService AuthService
@inject SipRegistrationService SipService
@inject OpenCaddisConfigService ConfigService
@inject IJSRuntime JS
@implements IDisposable

<div class="d-flex flex-column gap-4">

    @* === Microsoft 365 Settings === *@
    <section>
        <h5 class="fw-semibold mb-1">Microsoft 365 Settings</h5>
        <p class="text-body-secondary small mb-3">Azure AD app registration for Microsoft Graph API access.</p>

        <div class="card">
            <div class="card-body">
                <p class="text-body-secondary small mb-3">
                    Enter your Azure AD Application (client) ID. See the
                    <a href="https://github.com/vulcan365/OpenCaddis#microsoft-365-setup" target="_blank">README</a>
                    for instructions on creating an app registration.
                </p>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Client ID</label>
                        <input @bind="_clientId" class="form-control" placeholder="Azure AD Application (client) ID" />
                    </div>
                </div>
                <div class="d-flex justify-content-end mt-3">
                    <button class="btn btn-primary btn-sm" @onclick="SaveSettings">
                        <i class="bi bi-save me-1"></i> Save Settings
                    </button>
                </div>
                @if (_settingsSaved)
                {
                    <div class="alert alert-success mt-3 mb-0 py-2">Settings saved.</div>
                }
            </div>
        </div>
    </section>

    @* === Connection Status === *@
    <section>
        <h5 class="fw-semibold mb-1">Connection Status</h5>
        <p class="text-body-secondary small mb-3">Connect to Microsoft 365 to enable email tools for agents.</p>

        <div class="card">
            <div class="card-body">

                @if (AuthService.IsConnected)
                {
                    @* Connected state *@
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-success">Connected</span>
                        @if (AuthService.UserDisplayName is not null)
                        {
                            <span class="fw-semibold">@AuthService.UserDisplayName</span>
                        }
                        @if (AuthService.UserEmail is not null)
                        {
                            <span class="text-body-secondary">(@AuthService.UserEmail)</span>
                        }
                    </div>

                    @if (AuthService.ConsentedScopes is { Length: > 0 })
                    {
                        <div class="mb-3">
                            <span class="text-body-secondary small me-2">Scopes:</span>
                            @foreach (var scope in AuthService.ConsentedScopes)
                            {
                                <span class="badge bg-secondary me-1">@scope</span>
                            }
                        </div>
                    }

                    <button class="btn btn-outline-danger btn-sm" @onclick="Disconnect">
                        <i class="bi bi-x-circle me-1"></i> Disconnect
                    </button>
                }
                else if (AuthService.IsPolling && AuthService.CurrentDeviceCode is not null)
                {
                    @* Device code flow in progress *@
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-info">Connecting...</span>
                        <div class="spinner-border spinner-border-sm text-info" role="status">
                            <span class="visually-hidden">Polling...</span>
                        </div>
                    </div>

                    <div class="alert alert-info mb-3">
                        <p class="mb-2">To sign in, open your browser and go to:</p>
                        <p class="mb-2">
                            <a href="@AuthService.CurrentDeviceCode.VerificationUri" target="_blank" class="fw-bold">
                                @AuthService.CurrentDeviceCode.VerificationUri
                            </a>
                        </p>
                        <p class="mb-2">Enter this code:</p>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <code class="fs-4 fw-bold p-2 rounded border" style="background-color: var(--oc-bg-raised); color: var(--oc-accent);">@AuthService.CurrentDeviceCode.UserCode</code>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="CopyCode">
                                <i class="bi bi-clipboard me-1"></i> Copy
                            </button>
                        </div>
                        <p class="text-body-secondary small mb-0">
                            This code expires at @AuthService.CurrentDeviceCode.ExpiresAt.LocalDateTime.ToString("HH:mm:ss").
                        </p>
                    </div>

                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelConnect">
                        <i class="bi bi-x me-1"></i> Cancel
                    </button>
                }
                else
                {
                    @* Not connected *@
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-warning text-dark">Not connected</span>
                    </div>

                    @if (AuthService.LastError is not null)
                    {
                        <div class="alert alert-danger mb-3 py-2">@AuthService.LastError</div>
                    }

                    <button class="btn btn-primary btn-sm" @onclick="StartConnect"
                            disabled="@string.IsNullOrEmpty(_clientId)">
                        <i class="bi bi-plug me-1"></i> Connect to Microsoft 365
                    </button>

                    @if (string.IsNullOrEmpty(_clientId))
                    {
                        <p class="text-body-secondary small mt-2 mb-0">Save your Client ID above first.</p>
                    }
                }

            </div>
        </div>
    </section>

    @* === SIP Phone Settings === *@
    <section>
        <h5 class="fw-semibold mb-1">SIP Phone Settings</h5>
        <p class="text-body-secondary small mb-3">SIP registration for voice connectivity.</p>

        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">SIP Domain</label>
                        <input @bind="_sipDomain" class="form-control" placeholder="domain.example.service" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Outbound Proxy <span class="text-body-secondary">(optional)</span></label>
                        <input @bind="_sipOutboundProxy" class="form-control" placeholder="proxy.example.com" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Port</label>
                        <input @bind="_sipPort" type="number" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Transport</label>
                        <select @bind="_sipTransport" class="form-select">
                            <option value="udp">UDP</option>
                            <option value="tcp">TCP</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Username</label>
                        <input @bind="_sipUsername" class="form-control" placeholder="SIP username or extension" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Password</label>
                        <input @bind="_sipPassword" type="password" class="form-control" placeholder="@(_hasSavedSipPassword ? "(saved — leave blank to keep)" : "")" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Extension <span class="text-body-secondary">(optional)</span></label>
                        <input @bind="_sipExtension" class="form-control" placeholder="Extension number" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Display Name <span class="text-body-secondary">(optional)</span></label>
                        <input @bind="_sipDisplayName" class="form-control" placeholder="Caller display name" />
                    </div>
                </div>
                <div class="d-flex justify-content-end mt-3">
                    <button class="btn btn-primary btn-sm" @onclick="SaveSipSettings">
                        <i class="bi bi-save me-1"></i> Save Settings
                    </button>
                </div>
                @if (_sipSettingsSaved)
                {
                    <div class="alert alert-success mt-3 mb-0 py-2">SIP settings saved.</div>
                }
            </div>
        </div>
    </section>

    @* === SIP Registration Status === *@
    <section>
        <h5 class="fw-semibold mb-1">SIP Registration Status</h5>
        <p class="text-body-secondary small mb-3">Register with the SIP server to enable voice calls.</p>

        <div class="card">
            <div class="card-body">
                @if (SipService.IsRegistered)
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-success">Registered</span>
                        <span class="fw-semibold">@SipService.RegisteredUser</span>
                        <span class="text-body-secondary">on @SipService.RegisteredServer</span>
                    </div>

                    @if (SipService.LastRegistrationTime is not null)
                    {
                        <p class="text-body-secondary small mb-3">
                            Last registered: @SipService.LastRegistrationTime.Value.LocalDateTime.ToString("g")
                        </p>
                    }

                    <button class="btn btn-outline-danger btn-sm" @onclick="StopSipRegistration">
                        <i class="bi bi-x-circle me-1"></i> Unregister
                    </button>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-warning text-dark">Not registered</span>
                    </div>

                    @if (SipService.LastError is not null)
                    {
                        <div class="alert alert-danger mb-3 py-2">@SipService.LastError</div>
                    }

                    <button class="btn btn-primary btn-sm" @onclick="StartSipRegistration"
                            disabled="@string.IsNullOrEmpty(_sipDomain)">
                        <i class="bi bi-telephone me-1"></i> Register
                    </button>

                    @if (string.IsNullOrEmpty(_sipDomain))
                    {
                        <p class="text-body-secondary small mt-2 mb-0">Save your SIP settings above first.</p>
                    }
                }
            </div>
        </div>
    </section>

    @* === Call Status === *@
    @if (SipService.IsRegistered)
    {
        <section>
            <h5 class="fw-semibold mb-1">Call Status</h5>
            <p class="text-body-secondary small mb-3">Incoming call handling for the registered SIP extension.</p>

            <div class="card">
                <div class="card-body">
                    @if (SipService.IsInCall)
                    {
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge bg-success">In Call</span>
                            <span class="fw-semibold">@SipService.ActiveCallFrom</span>
                        </div>

                        @if (SipService.CallStartTime is not null)
                        {
                            <p class="text-body-secondary small mb-3">
                                Started: @SipService.CallStartTime.Value.LocalDateTime.ToString("g")
                            </p>
                        }

                        <button class="btn btn-outline-danger btn-sm" @onclick="HangupCall">
                            <i class="bi bi-telephone-x me-1"></i> Hang Up
                        </button>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge bg-secondary">Idle</span>
                            <span class="text-body-secondary">No active call</span>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
</div>

@code {
    private string _clientId = "";
    private bool _settingsSaved;
    private string? _connectError;

    // SIP fields
    private string _sipDomain = "";
    private string _sipOutboundProxy = "";
    private int _sipPort = 5060;
    private string _sipTransport = "udp";
    private string _sipUsername = "";
    private string _sipPassword = "";
    private string _sipExtension = "";
    private string _sipDisplayName = "";
    private bool _sipSettingsSaved;
    private bool _hasSavedSipPassword;

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnConnectionChanged += HandleConnectionChanged;
        SipService.OnConnectionChanged += HandleConnectionChanged;
        SipService.OnCallStateChanged += HandleConnectionChanged;

        if (ConfigService.ConfigurationExists())
        {
            var config = await ConfigService.LoadConfigurationAsync();
            if (config.Microsoft365 is { ClientId.Length: > 0 })
            {
                _clientId = config.Microsoft365.ClientId;
            }

            if (config.SipPhone is not null)
            {
                _sipDomain = config.SipPhone.Domain;
                _sipOutboundProxy = config.SipPhone.OutboundProxy ?? "";
                _sipPort = config.SipPhone.Port;
                _sipTransport = config.SipPhone.Transport;
                _sipUsername = config.SipPhone.Username;
                _sipExtension = config.SipPhone.Extension ?? "";
                _sipDisplayName = config.SipPhone.DisplayName ?? "";
                _hasSavedSipPassword = !string.IsNullOrEmpty(config.SipPhone.EncryptedPassword);
            }
        }
    }

    private async Task SaveSettings()
    {
        _settingsSaved = false;

        var config = ConfigService.ConfigurationExists()
            ? await ConfigService.LoadConfigurationAsync()
            : new OpenCaddisConfigurationDto();

        config.Microsoft365 ??= new Microsoft365ConfigurationDto();
        config.Microsoft365.ClientId = _clientId;

        await ConfigService.SaveConfigurationAsync(config);
        AuthService.Configure(_clientId);
        _settingsSaved = true;
    }

    private async Task StartConnect()
    {
        _connectError = null;
        try
        {
            AuthService.Configure(_clientId);
            await AuthService.StartDeviceCodeFlowAsync();
        }
        catch (Exception ex)
        {
            _connectError = ex.Message;
        }
    }

    private void CancelConnect()
    {
        AuthService.CancelDeviceCodeFlow();
    }

    private async Task Disconnect()
    {
        await AuthService.DisconnectAsync();
    }

    private async Task CopyCode()
    {
        if (AuthService.CurrentDeviceCode is not null)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", AuthService.CurrentDeviceCode.UserCode);
        }
    }

    private async Task SaveSipSettings()
    {
        _sipSettingsSaved = false;

        var config = ConfigService.ConfigurationExists()
            ? await ConfigService.LoadConfigurationAsync()
            : new OpenCaddisConfigurationDto();

        config.SipPhone ??= new SipConfigurationDto();
        config.SipPhone.Domain = _sipDomain;
        config.SipPhone.OutboundProxy = string.IsNullOrWhiteSpace(_sipOutboundProxy) ? null : _sipOutboundProxy;
        config.SipPhone.Port = _sipPort;
        config.SipPhone.Transport = _sipTransport;
        config.SipPhone.Username = _sipUsername;
        config.SipPhone.Extension = string.IsNullOrWhiteSpace(_sipExtension) ? null : _sipExtension;
        config.SipPhone.DisplayName = string.IsNullOrWhiteSpace(_sipDisplayName) ? null : _sipDisplayName;

        if (!string.IsNullOrEmpty(_sipPassword))
        {
            config.SipPhone.EncryptedPassword = SipService.EncryptPassword(_sipPassword);
            _hasSavedSipPassword = true;
            _sipPassword = "";
        }

        await ConfigService.SaveConfigurationAsync(config);
        _sipSettingsSaved = true;
    }

    private async Task StartSipRegistration()
    {
        await SaveSipSettings();
        _sipSettingsSaved = false;

        var config = await ConfigService.LoadConfigurationAsync();
        if (config.SipPhone is not null)
        {
            await SipService.StartRegistrationAsync(config.SipPhone);
        }
    }

    private void StopSipRegistration()
    {
        SipService.Stop();
    }

    private void HangupCall()
    {
        SipService.HangupCall();
    }

    private void HandleConnectionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.OnConnectionChanged -= HandleConnectionChanged;
        SipService.OnConnectionChanged -= HandleConnectionChanged;
        SipService.OnCallStateChanged -= HandleConnectionChanged;
    }
}
