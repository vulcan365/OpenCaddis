{
  "ModelConfigurations": [
    {
      "Name": "default",
      "Provider": "OpenRouter",
      "Uri": "https://openrouter.ai/api/v1",
      "Model": "anthropic/claude-sonnet-4",
      "ApiKeyAlias": "default-key",
      "TimeoutSeconds": 60,
      "MaxOutputTokens": null
    },
    {
      "Name": "embeddings",
      "Provider": "OpenAI",
      "Uri": "",
      "Model": "text-embedding-ada-002",
      "ApiKeyAlias": "embeddings-key",
      "TimeoutSeconds": 60,
      "MaxOutputTokens": null
    }
  ],
  "ApiKeys": [
    {
      "Alias": "default-key",
      "Value": "YOUR_OPENROUTER_API_KEY"
    },
    {
      "Alias": "embeddings-key",
      "Value": "YOUR_OPENAI_API_KEY"
    }
  ]
}
