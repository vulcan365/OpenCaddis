<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OpenCaddis.App.ServerPage"
             Title="Server">

    <ScrollView>
        <VerticalStackLayout
            Padding="48"
            Spacing="24"
            MaximumWidthRequest="760"
            HorizontalOptions="Start">

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="OpenCaddis Server"
                    FontSize="32"
                    FontFamily="OpenSansSemibold"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Text="Run and manage the local OpenCaddis server."
                    FontSize="16"
                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
            </VerticalStackLayout>

            <Border Padding="24">
                <VerticalStackLayout Spacing="18">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <BoxView
                            x:Name="StatusIndicator"
                            WidthRequest="12"
                            HeightRequest="12"
                            CornerRadius="6"
                            Color="{StaticResource Gray400}"
                            VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label
                                x:Name="StatusLabel"
                                Text="Stopped"
                                FontFamily="OpenSansSemibold"
                                FontSize="18" />
                            <Label
                                x:Name="StatusMessageLabel"
                                Text="The server is not running."
                                LineBreakMode="WordWrap"
                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Local port" FontFamily="OpenSansSemibold" />
                        <Entry
                            x:Name="PortEntry"
                            WidthRequest="180"
                            HorizontalOptions="Start"
                            Keyboard="Numeric"
                            MaxLength="5"
                            TextChanged="OnPortTextChanged"
                            SemanticProperties.Description="Local server port" />
                        <Label
                            x:Name="UrlLabel"
                            FontFamily="OpenSansSemibold"
                            TextColor="{StaticResource Primary}" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="12">
                        <Button x:Name="StartButton" Text="Start" Clicked="OnStartClicked" />
                        <Button x:Name="StopButton" Text="Stop" Clicked="OnStopClicked" />
                        <Button x:Name="RestartButton" Text="Restart" Clicked="OnRestartClicked" />
                        <Button x:Name="OpenButton" Text="Open in browser" Clicked="OnOpenClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
